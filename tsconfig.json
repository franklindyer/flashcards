{
"compilerOptions": {
  "target": "es2022",
  "lib": ["dom", "dom.iterable", "esnext", "es6", "dom.asynciterable"],
  "allowJs": true,
  "skipLibCheck": true,
  "allowSyntheticDefaultImports": true,
  "strict": true,
  "forceConsistentCasingInFileNames": true,
  "noFallthroughCasesInSwitch": true,
  "outDir": "dist",
  "rootDir": "src",
  "module": "commonjs",
  "types": ["node", "jest"],
  "resolveJsonModule": true,
  "moduleResolution": "node",
  "esModuleInterop": true,
  "allowSyntheticDefaultImports": true,
  "paths": {
    "utils/*": ["./src/utils/*"],
    "core/*": ["./src/core/*"],
    "decks/*": ["./src/decks/*"],
    "menus/*": ["./src/menus/*"],
    "plotly.js": [
      "../node_modules/plotly.js/lib/core.js"
    ]
  }
},
"include": ["src/**/*"],
"exclude": ["node_modules"]
}
